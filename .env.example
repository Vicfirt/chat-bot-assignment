LLM_MODE=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://ollama:11434
# If the Ollama model/server is unreachable, serve the dummy LLM instead of erroring.
LLM_FALLBACK_DUMMY=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=irs_pubs
RAW_PDF_DIR=data/raw_pdfs
TAX_YEAR=2024
SEARCH_K=5
MIN_DOCS=3
CONTEXT_TOKEN_BUDGET=2000
MAX_RETRIES=1

# ingestion / chunking
PDF_EXTRACTOR=pdfplumber
CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=32
CHUNK_HEADING_SPLIT=true
CHUNK_TABLES_ATOMIC=true
CHUNK_KEEP_EXAMPLES_ATOMIC=true
INDEX_DROP_BOILERPLATE=true
INDEX_NUMERIC_DENSITY=0.28
API_URL=http://api:8000
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-000
LANGFUSE_SECRET_KEY=sk-lf-000
