LLM_MODE=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://ollama:11434
# If the Ollama model/server is unreachable, serve the dummy LLM instead of erroring.
LLM_FALLBACK_DUMMY=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=irs_pubs
RAW_PDF_DIR=data/raw_pdfs
TAX_YEAR=2025
SEARCH_K=5
MIN_DOCS=3
CONTEXT_TOKEN_BUDGET=900
MAX_RETRIES=1
GRAPH_RECURSION_LIMIT=25

# in-process caching (query embeddings + RAG subgraph results)
CACHE_ENABLED=true
CACHE_EMBEDDING_SIZE=512
CACHE_RAG_SIZE=256

# retrieval
RETRIEVAL_MODE=hybrid
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=20
FILTER_TAX_YEAR=true
BOOST_TABLES_FOR_AMOUNT_QUERIES=true
GRADE_MIN_SCORE=0.0

# ingestion / chunking
PDF_EXTRACTOR=pdfplumber
CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=32
CHUNK_HEADING_SPLIT=true
CHUNK_TABLES_ATOMIC=true
CHUNK_KEEP_EXAMPLES_ATOMIC=true
INDEX_DROP_BOILERPLATE=true
INDEX_NUMERIC_DENSITY=0.28
API_URL=http://api:8000

# logging
LOG_LEVEL=INFO
LOG_JSON=true
LOG_PII=false
