{
  "title": "Agentic RAG Tax Chatbot",
  "uid": "agentic-rag",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries", "title": "Request latency p95 by route", "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries", "title": "Per-node mean duration", "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(rag_node_duration_seconds_sum[5m])) by (node) / sum(rate(rag_node_duration_seconds_count[5m])) by (node)", "legendFormat": "{{node}}" }]
    },
    {
      "type": "stat", "title": "Throughput (req/s)", "id": 3,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(rag_requests_total[1m]))" }]
    },
    {
      "type": "stat", "title": "Error ratio", "id": 4,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "sum(rate(rag_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(rag_requests_total[5m])), 1)" }]
    },
    {
      "type": "timeseries", "title": "Validate retries", "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(rag_validate_retries_total[5m]))" }]
    }
  ]
}
