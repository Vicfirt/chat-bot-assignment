{
  "title": "Agentic RAG Tax Chatbot",
  "uid": "agentic-rag",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries", "title": "Request latency p95 by route", "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries", "title": "Main-graph per-node mean duration", "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(rag_node_duration_seconds_sum[5m])) by (node) / sum(rate(rag_node_duration_seconds_count[5m])) by (node)", "legendFormat": "{{node}}" }]
    },
    {
      "type": "stat", "title": "Throughput (req/s)", "id": 3,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(rag_requests_total[1m]))" }]
    },
    {
      "type": "stat", "title": "Error ratio", "id": 4,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "sum(rate(rag_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(rag_requests_total[5m])), 1)" }]
    },
    {
      "type": "timeseries", "title": "Validate retries", "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(rag_validate_retries_total[5m]))" }]
    },
    {
      "type": "timeseries", "title": "RAG subgraph per-node mean duration", "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum(rate(rag_subgraph_node_duration_seconds_sum[5m])) by (node) / sum(rate(rag_subgraph_node_duration_seconds_count[5m])) by (node)", "legendFormat": "{{node}}" }]
    },
    {
      "type": "timeseries", "title": "LLM call latency p95 by op", "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(rag_llm_duration_seconds_bucket[5m])) by (le, op))", "legendFormat": "{{op}}" }]
    },
    {
      "type": "stat", "title": "LLM dummy-fallbacks (rate)", "id": 8,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 24 },
      "targets": [{ "expr": "sum(rate(rag_llm_fallback_total[5m]))" }]
    },
    {
      "type": "stat", "title": "Context size p95 (words)", "id": 9,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 24 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(rag_context_words_bucket[5m])) by (le))" }]
    },
    {
      "type": "stat", "title": "Citations per request p95", "id": 10,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_chunks_bucket[5m])) by (le))" }]
    },
    {
      "type": "timeseries", "title": "LLM calls/s by op", "id": 11,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "targets": [{ "expr": "sum(rate(rag_llm_calls_total[5m])) by (op)", "legendFormat": "{{op}}" }]
    },
    {
      "type": "row", "title": "Offline eval (last run, via pushgateway)", "id": 12,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },
    {
      "type": "stat", "title": "Route accuracy", "id": 13,
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 33 },
      "targets": [{ "expr": "rag_eval_route_accuracy" }]
    },
    {
      "type": "stat", "title": "Retrieval hit-rate", "id": 14,
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 33 },
      "targets": [{ "expr": "rag_eval_retrieval_hit_rate" }]
    },
    {
      "type": "stat", "title": "Precision@k", "id": 15,
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 33 },
      "targets": [{ "expr": "rag_eval_precision_at_k" }]
    },
    {
      "type": "stat", "title": "Recall@k", "id": 16,
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 33 },
      "targets": [{ "expr": "rag_eval_recall_at_k" }]
    },
    {
      "type": "stat", "title": "MRR", "id": 17,
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 33 },
      "targets": [{ "expr": "rag_eval_mrr" }]
    },
    {
      "type": "stat", "title": "Rerank MRR lift", "id": 18,
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 33 },
      "targets": [{ "expr": "rag_eval_rerank_mrr_lift" }]
    }
  ]
}
